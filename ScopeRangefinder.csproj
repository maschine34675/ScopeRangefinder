<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ScopeRangefinder</RootNamespace>
    <Nullable>disable</Nullable>
    <Authors>maschine</Authors>
    <Company>https://github.com/maschine34675/ScopeRangefinder</Company>
    <AssemblyName>maschine-ScopeRangefinder</AssemblyName>
    <Copyright></Copyright>
    <AssemblyVersion>3.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <Configurations>Debug;Release;Package</Configurations>
    <Version>$(AssemblyVersion)</Version>
    <LangVersion>latest</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PhysicsModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>..\..\BepInEx\plugins\spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>..\..\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>..\..\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Comfort.Unity, Version=1.0.0.4, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Comfort.Unity.dll</HintPath>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\ItemComponent.Types.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
      <BuildTimestamp>$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))</BuildTimestamp>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(BuildInfoFile)"
      Overwrite="true"
      Lines="namespace ScopeRangefinder { internal static class BuildInfo { public const string Timestamp = &quot;$(BuildTimestamp)&quot;%3B } }" />
    <ItemGroup>
      <Compile Remove="$(BuildInfoFile)" />
      <Compile Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <BundledFontFiles Include="$(ProjectDir)fonts\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder" />
    <!-- The runtime marks the shipped preset file read-only, hence the overwrite flag. -->
    <Copy
      SourceFiles="$(ProjectDir)ScopeRangefinder.presets.json"
      DestinationFolder="$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder"
      OverwriteReadOnlyFiles="true"
      Condition="Exists('$(ProjectDir)ScopeRangefinder.presets.json')" />
    <Copy
      SourceFiles="$(ProjectDir)ScopeRangefinder.layouts.json"
      DestinationFolder="$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder"
      Condition="Exists('$(ProjectDir)ScopeRangefinder.layouts.json') And !Exists('$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder\ScopeRangefinder.layouts.json')" />
    <Copy
      SourceFiles="@(BundledFontFiles)"
      DestinationFolder="$(ProjectDir)..\..\BepInEx\plugins\maschine-ScopeRangefinder\fonts" />
    <Delete Files="$(ProjectDir)..\..\BepInEx\plugins\$(TargetFileName)" />
  </Target>

  <!--
    Release builds also produce the distributable zip next to the project:
    maschine-ScopeRangefinder-<version>.zip with the BepInEx/plugins/... layout.
    ScopeRangefinder.layouts.json is deliberately NOT packaged: it holds user
    overrides and shipping it would overwrite them on update.
  -->
  <Target Name="CreateReleaseZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(ProjectDir)obj\package\</PackageRoot>
      <PackagePluginDir>$(PackageRoot)BepInEx\plugins\maschine-ScopeRangefinder\</PackagePluginDir>
      <ReleaseZipPath>$(ProjectDir)maschine-ScopeRangefinder-$(AssemblyVersion).zip</ReleaseZipPath>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(ProjectDir)ScopeRangefinder.presets.json')"
      Text="ScopeRangefinder.presets.json is missing; refusing to package an incomplete release." />
    <ItemGroup>
      <ReleaseFontFiles Include="$(ProjectDir)fonts\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <MakeDir Directories="$(PackagePluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackagePluginDir)" />
    <Copy SourceFiles="$(ProjectDir)ScopeRangefinder.presets.json" DestinationFolder="$(PackagePluginDir)" />
    <Copy SourceFiles="@(ReleaseFontFiles)" DestinationFolder="$(PackagePluginDir)fonts" />
    <Delete Files="$(ReleaseZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(ReleaseZipPath)" />
    <Message Importance="high" Text="Release package created: $(ReleaseZipPath)" />
  </Target>
</Project>
